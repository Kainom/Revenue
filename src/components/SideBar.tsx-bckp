import Image from "next/image";
import { ReactElement, ReactNode } from "react";
import React from "react";
import Revenue from "@/assets/expense.png";
import { Home, User, Settings } from "lucide-react";
import Link from "next/link";

interface PropsCustomLink {
  text: string;
  icon: ReactNode;
  children: ReactNode;
}

export const CustomLink = ({
  href,
  text,
}: {
  href: string;
  text: string;
}): ReactNode => {
  return (
    <>
      <div>
        <Link href={href}>text</Link>
      </div>
    </>
  );
};

export const Expand: React.FC<PropsCustomLink> = ({
  text,
  children,
  icon,
}): ReactElement => {
  return (
    <div className="bg-red-900 w-full flex  p-4 gap-2">
      <span>{icon}</span>
      <h3 className="opacity-0 group-hover:opacity-100 duration-1000 transition-all group-hover:transition- ">
        {text}
      </h3>
    </div>
  );
};

export const SideBar = ({
  children,
}: {
  children: ReactNode;
}): ReactElement => {
  return (
    <div className="w-16 hover:w-32 transition-all duration-300 bg-gray-800 h-screen fixed top-0">
      <div className="group absolute inset-0 flex flex-col items-center text-white  transition-opacity duration-700">{children}</div>
    </div>
  );
};
